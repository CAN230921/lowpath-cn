[Unit]
Description=Lowpath authenticated HTTP/3 gateway
Wants=network-online.target lowpath-masque-forward.service
After=network-online.target lowpath-masque-forward.service

[Service]
DynamicUser=yes
StateDirectory=lowpath-masque
StateDirectoryMode=0700
LoadCredential=access-token:/etc/lowpath-masque/token
EnvironmentFile=/etc/lowpath-masque/site
ExecStart=/usr/local/bin/lowpath-masque-edge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
