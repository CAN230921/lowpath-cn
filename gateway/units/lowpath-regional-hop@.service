[Unit]
Description=Lowpath regional UDP forwarding hop (%i)
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/lowpath-regional/%i.env
ExecStart=/usr/local/lib/lowpath-regional/relay -listen ${LISTEN} -peer ${PEER} -forward ${NEXT}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
